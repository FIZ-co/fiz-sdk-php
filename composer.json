{
    "name": "fiz-co/sdk",
    "description": "Official PHP SDK for the FIZ API: issue AT-certified invoices in Portugal (faturação certificada, ATCUD, QR code, SAF-T) from your code.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "fiz",
        "invoicing",
        "invoice",
        "portugal",
        "faturação",
        "faturacao certificada",
        "fatura",
        "AT",
        "autoridade tributária",
        "ATCUD",
        "SAF-T",
        "e-fatura",
        "IVA",
        "VAT",
        "api",
        "sdk"
    ],
    "homepage": "https://api.fiz.co",
    "authors": [
        {
            "name": "FIZ",
            "homepage": "https://fiz.co"
        }
    ],
    "support": {
        "issues": "https://github.com/FIZ-co/fiz-sdk-php/issues",
        "source": "https://github.com/FIZ-co/fiz-sdk-php",
        "docs": "https://api.fiz.co"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.32",
        "justinrainbow/json-schema": "6.15.1",
        "phpstan/phpstan": "2.3.7",
        "phpunit/phpunit": "10.5.67"
    },
    "autoload": {
        "psr-4": {
            "Fiz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fiz\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "generate": "@php scripts/generate.php",
        "update-spec": [
            "@php scripts/update-spec.php",
            "@generate"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check:readme": [
            "@php scripts/check-readme.php",
            "phpstan analyse --memory-limit=1G -c phpstan.readme.neon"
        ],
        "test": "phpunit --testsuite unit",
        "test:sandbox": "phpunit --testsuite sandbox",
        "check": [
            "@cs",
            "@phpstan",
            "@check:readme",
            "@test"
        ],
        "method-map": "@php scripts/method-map.php"
    },
    "scripts-descriptions": {
        "generate": "Regenerate src/Generated/ from openapi/openapi.json",
        "update-spec": "Download the live API document and regenerate",
        "cs": "Check the code style (PSR-12)",
        "phpstan": "PHPStan at max level on src/ and examples/",
        "check:readme": "Lint and analyse every PHP block of README.md",
        "test": "Unit tests (mocked HTTP)",
        "test:sandbox": "End-to-end tests against the API sandbox (needs FIZ_TEST_API_KEY)",
        "check": "Everything CI runs",
        "method-map": "Rewrites method-map.json (the method behind each API operation, for the API docs)."
    }
}
